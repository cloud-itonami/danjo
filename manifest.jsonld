  "@type": "ActorManifest",
  "id": "did:web:danjo.etzhayyim.com",
  "name": "danjo",
  "displayName": "弾正 — Public-Accountability Oversight",
  "displayNameJa": "弾正",
  "displayNameEn": "Danjo",
  "description": "kotoba-native public-accountability oversight substrate. Ingests the already-IPFS-pinned open-government corpus (JP 国会会議録 / 予算書 / 政府調達 per ADR-2605263900) into kotoba EAVT and emits FACTUAL, source-cited, NON-adjudicating discrepancy observations + aggregate transparency reports. The censor's eye without the censor's sword: observation + transparent publication ONLY. NON-adjudicating (G4, UPL-equivalent). Passive-only ingestion (G3; pre-published public records only; no live scraping, no surveillance, no leak intake). Open method (G6). Murakumo-only inference (G7). Transparent Religious Force discipline (G11, ADR-2605192100 §1.12). 6 cells / 4 Lexicons / 13 gates / 12 non-goals.",
  "descriptionJa": "kotoba-native の公的アカウンタビリティ監察 substrate。既に IPFS pin 済みの open-government corpus (日本の 国会会議録 / 予算書 / 政府調達, ADR-2605263900) を kotoba EAVT に ingest し、事実に基づく出典付き・非裁定の discrepancy observation + 集計透明レポートを発行。弾正台の「監察の眼」のみで「弾劾の剣」は持たない: observation + 透明公開のみ。非裁定 (G4, UPL 等価; 「不正・違反があった」とは断定しない — 法的性格付けは chigiri + Public Fund 経由の外部 counsel)。受動取得のみ (G3; 事前公開された公的記録のみ; ライブ scraping・監視・内部告発受付なし)。手法公開 (G6)。Murakumo-only 推論 (G7)。Transparent Religious Force 規律 (G11, ADR-2605192100 §1.12)。日本先行 (R0); architecture は jurisdiction 汎用。6 cells / 4 Lexicons / 13 gates / 12 non-goals。",
  "adr": {
    "master": "etzhayyim:adr:2605301600",
    "parent": "etzhayyim:adr:2605263900",
    "r0": "etzhayyim:adr:2605301600",
    "r1": "reserved",
    "r2": "reserved",
    "r3": "reserved"
  },
  "tier": "Tier-B",
  "parentActor": null,
  "crossActorBoundary": [
    "did:web:toritate.etzhayyim.com (BOUNDARY: toritate = religious-corp's OWN on-chain books; danjo = the STATE's published open-data books; cross-reference where a vendor appears in both)",
    "did:web:chigiri.etzhayyim.com (legal-characterization + external-counsel routing for any observation needing legal opinion — UPL boundary G4; chigiri.data_privacy for DSARs G9)",
    "did:web:ossekai.etzhayyim.com (danjo oversightReport → ossekai aggregate-anonymized §1.12 publication; ADR-2605264000)",
    "did:web:kataribe.etzhayyim.com (danjo oversightReport is a citable primary source for press / publishing)",
    "did:web:tadori.etzhayyim.com (sibling kotoba-native investigation actor — on-chain crypto tracing; shared EAVT pattern, disjoint domain; ADR-2605301400)",
    "kotoba QuadStore EAVT (cross-reference graph store; ADR-2605262130; no RisingWave / no projection layer)"
  ],
  "lexiconReadAccess": {
    "com.etzhayyim.gov.dataset.parliamentRecord": "ADR-2605263900; READ-ONLY JP 国会会議録 (Diet member-statement / debate / vote / bill). Indexed into kotoba EAVT by danjo_diet_statement_index. Passive-only (pre-published bulk archive).",
    "com.etzhayyim.gov.dataset.procurementRecord": "ADR-2605263900; READ-ONLY JP 政府調達 (tender / award / modification / cancellation). awardeeLei cross-link to corp.leiReference. Indexed by danjo_procurement_graph.",
    "com.etzhayyim.gov.dataset.budgetRecord": "ADR-2605263900; READ-ONLY JP 予算書 (appropriation / outlay / subaward). recipientLei cross-link. Indexed by danjo_budget_ledger.",
    "com.etzhayyim.gov.dataset.statisticsObservation": "ADR-2605263900; READ-ONLY e-Stat indicator observations (denominator / baseline context for cross-reference).",
    "com.etzhayyim.gov.dataset.openDatasetAttestation": "ADR-2605263900; READ-ONLY data.go.jp / e-Stat per-portal catalog entry (provenance lineage).",
    "com.etzhayyim.corp.leiReference": "ADR-2605263800; READ-ONLY GLEIF LEI canonical for awardee / recipient identity resolution. CC0 1.0.",
    "com.etzhayyim.corp.ownershipEdge": "ADR-2605263800; READ-ONLY UBO + parent-subsidiary + officer-edge traversal for cross-reference links (e.g. awardee UBO-linked to a contracting official per public registry). GLEIF L2 (CC0) + OpenCorporates open-data."
  },
  "form": "任意団体 internal civic-transparency oversight substrate (NOT 一般社団 / NPO / 公益財団 / 宗教法人 法人格 — Preamble §0.4 Lv7+ unanimity lock; NOT a state-recognized audit organ, NOT 会計検査院)",
  "constitutionalDiscipline": {
    "nonAdjudicating": "G4 — UPL-equivalent (chigiri G14 / toritate G5). danjo emits FACTUAL cross-reference observations only; it MUST NOT assert that a crime / law violation / 不正 occurred. Every discrepancyObservation carries nonAdjudicatingNotice=true. Legal characterization via external counsel (chigiri + Public Fund Council Lv6+).",
    "passiveOnlyIngestion": "G3 — reads ONLY the pre-published, IPFS-pinned gov.dataset.* corpus (ADR-2605263900). No live portal scraping, no per-query API, no non-public sources, no whistleblower intake (Charter Rider §2(c) covert-ops avoidance).",
    "sourceProvenanceMandatory": "G5 — every observation cites ≥2 upstream gov.dataset.* record CIDs. No inference-only allegation.",
    "openMethod": "G6 — every detector heuristic published as a methodNote (open, versioned). No closed / secret scoring.",
    "transparentForce": "G11 — observation + transparent publication ONLY. NO coercive action, NO referral to state coercion as an internal dependency, NO covert operation. 1 SBT = 1 vote governs named-party publication (ADR-2605192100 §1.12).",
    "noCommercialGovIntel": "G8 — GovWin IQ / Bloomberg Government / Politico Pro / E&E News Pro / FiscalNote / CQ Roll Call Pro PROHIBITED (Charter Rider §2(e) anti-gatekeeping). Deny-list lint.",
    "murakumoOnlyInference": "G7 — Murakumo-only inference per ADR-2605215000; no vendor LLM API callout.",
    "readOnly": "G12 — never mutates upstream gov.dataset.* records nor any on-chain contract."
  },
  "scope": {
    "phase": "R0 scaffold",
    "scopeBoundary": "Cross-reference of pre-published open-government records + non-adjudicating discrepancy observation + aggregate transparency publication. JP-first; jurisdiction-generic architecture.",
    "exclusions": [
      "prosecutor / law-enforcement arm",
      "court / adjudicator of guilt or of 'violation'",
      "surveillance system (live monitoring of individuals)",
      "commercial gov-intelligence product (GovWin / Bloomberg Government / FiscalNote)",
      "whistleblower-intake / non-public-leak handler",
      "state-granted legal personality (NOT 宗教法人法 登記)",
      "closed-source / secret-scoring engine",
      "partisan / electioneering tool",
      "per-individual reputation / social-credit score",
      "replacement for the state's own audit organs (会計検査院)",
      "defamation vector (structurally prevented by G4/G5/G6/G10/G11)",
      "Japan-exclusive architecture (jurisdiction-generic)"
    ]
  },
  "cells": [
    {
      "name": "diet_statement_index",
      "module": "kotodama.cells.danjo_diet_statement_index",
      "murakumoNode": "reuben",
      "phase": "continuous",
      "io": "gov.dataset.parliamentRecord (JP 国会会議録) → kotoba EAVT datoms (member ↔ statement ↔ topic ↔ session ↔ date)"
    },
    {
      "name": "procurement_graph",
      "module": "kotodama.cells.danjo_procurement_graph",
      "murakumoNode": "reuben",
      "phase": "continuous",
      "io": "gov.dataset.procurementRecord (JP 政府調達) → datoms (authority ↔ award ↔ awardeeLei ↔ amount ↔ date)"
    },
    {
      "name": "budget_ledger",
      "module": "kotodama.cells.danjo_budget_ledger",
      "murakumoNode": "reuben",
      "phase": "continuous",
      "io": "gov.dataset.budgetRecord (JP 予算書) → datoms (appropriation ↔ outlay ↔ recipientLei ↔ program)"
    },
    {
      "name": "crossref_engine",
      "module": "kotodama.cells.danjo_crossref_engine",
      "murakumoNode": "gad",
      "phase": "continuous",
      "io": "join indices + corp.ownershipEdge (UBO) + corp.leiReference → crossReferenceLink edges + candidate discrepancyObservation"
    },
    {
      "name": "statement_consistency",
      "module": "kotodama.cells.danjo_statement_consistency",
      "murakumoNode": "gad",
      "phase": "continuous",
      "io": "cross-ref Diet statements vs budget/procurement reality → discrepancyObservation (statement-vs-record divergence)"
    },
    {
      "name": "oversight_report",
      "module": "kotodama.cells.danjo_oversight_report",
      "murakumoNode": "naphtali",
      "phase": "periodic (event)",
      "io": "aggregate observations → oversightReport + Council Lv6+ ≥3 attestation chain"
    }
  ],
  "lexiconNamespaces": [
    "com.etzhayyim.danjo.discrepancyObservation",
    "com.etzhayyim.danjo.crossReferenceLink",
    "com.etzhayyim.danjo.oversightReport",
    "com.etzhayyim.danjo.methodNote"
  ],
  "constitutionalGates": {
    "description": "13 immutable gates per ADR-2605301600 §4. Council Lv6+ supermajority + new ADR to amend.",
    "gates": {
      "G1": "Charter Rider §2(a)-(h) scan on every published observation + report",
      "G2": "kotoba attestation lineage on every record",
      "G3": "Passive-only ingestion — only pre-published IPFS-pinned gov.dataset.* corpus; no live scraping / no per-query API / no non-public sources / no whistleblower intake (§2(c) covert-ops avoidance)",
      "G4": "NON-adjudicating (UPL-equivalent) — factual cross-reference only; never asserts a crime / violation / 不正 occurred; nonAdjudicatingNotice=true on every observation; legal characterization via external counsel (chigiri + Public Fund)",
      "G5": "Source-provenance mandatory — ≥2 upstream gov.dataset.* record CIDs per observation; no inference-only allegation",
      "G6": "Open method — every detector heuristic published as methodNote (open, versioned); no closed / secret scoring",
      "G7": "Murakumo-only inference (ADR-2605215000)",
      "G8": "No commercial gov-intelligence terminals (GovWin IQ / Bloomberg Government / Politico Pro / E&E News Pro / FiscalNote / CQ Roll Call Pro PROHIBITED)",
      "G9": "Per-jurisdiction publication-rule honoring — no unilateral re-identification; DSARs route via chigiri.data_privacy to upstream publisher; danjo never adds/removes PII",
      "G10": "Aggregate-first + severity-gated naming — named-party observation only where source records already name the party AND severity-gated + Council-reviewed",
      "G11": "Transparent Religious Force discipline (§1.12) — observation + publication ONLY; no coercion; no state-coercion dependency; no covert op; 1 SBT = 1 vote governs named-party publication",
      "G12": "Read-only — never mutates upstream gov.dataset.* records nor any on-chain contract",
      "G13": "stateAlignedFlag pass-through — CN-class / state-aligned sources carry the flag into every derived publication"
    }
  },
  "nonGoals": {
    "description": "12 explicitly excluded scopes",
    "goals": {
      "N1": "NOT a prosecutor / law-enforcement arm",
      "N2": "NOT a court / adjudicator of guilt or of 'violation'",
      "N3": "NOT a surveillance system (public-record only; no live monitoring)",
      "N4": "NOT a commercial gov-intelligence product",
      "N5": "NOT a whistleblower-intake / non-public-leak handler",
      "N6": "NOT a state-granted legal personality",
      "N7": "NOT a closed-source / secret-scoring engine",
      "N8": "NOT a partisan / electioneering tool",
      "N9": "NOT a per-individual reputation / social-credit score",
      "N10": "NOT a replacement for the state's own audit organs (会計検査院)",
      "N11": "NOT a defamation vector (structurally prevented by G4/G5/G6/G10/G11)",
      "N12": "NOT Japan-exclusive in architecture (JP-first at R0; jurisdiction-generic)"
    }
  },
