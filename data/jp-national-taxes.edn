;; jp-national-taxes.edn — 日本の国税レジストリ (danjo revenue-ledger, 国全体の税金).
;;
;; 所得税だけでなく主要な国税を網羅し、各税の「使途追跡可能性」を earmark の実態で分類する。
;; これは danjo の誠実さの核 — 税が「どこにどう使われるか1円単位で追えるか」は税目で三段階に分かれる:
;;
;;   :general          一般会計・普通税。ノン・アフェクタシオン原則で資金は代替可能(fungible)。
;;                     特定の1円の使途は会計的に存在しない → per-yen 追跡 不可。
;;   :statutory-purpose 目的税的: 法律が充当先を定める(例 消費税→社会保障4経費, 消費税法1条2項)が、
;;                     一般会計内のため資金は依然 fungible。法的な「充当方向」は事実として報告できるが、
;;                     特定の1円の追跡は 不可(誠実な中間カテゴリ)。
;;   :special-account  特別会計へ繰入される特定財源(例 復興特別所得税→復興特会, 電源開発促進税→
;;                     エネルギー特会)。閉じた会計境界内で繰入額→歳出を1円単位で照合できる → per-yen 可。
;;
;; 注: 揮発油税・自動車重量税は かつて道路特定財源だったが 2009 に一般財源化 → 現在 :general
;; (この履歴は :note に明記)。全数値 :representative(実構造に基づくが G7 ライブ検証前)。
;; :collected-by / :administered-by は data/jp-fiscal-orgs.edn の org ハンドル。NOT 権威ある statement。

{:source-sensor "jp_zeisei" :jurisdiction "jpn" :currency-iso4217 "JPY"
 :verification-status "representative" :fiscal-year 2024
 :primary-sources ["https://www.mof.go.jp/tax_policy/summary/"
                   "https://www.nta.go.jp/"
                   "https://www.mof.go.jp/policy/budget/budger_workflow/account/special/"]
 :taxes
 [;; ── 一般会計・普通税 (fungible, per-yen 追跡 不可) ───────────────────────────────
  {:id :income-withholding :ja "源泉所得税" :en "Withholding income tax"
   :collected-by :nta :account :general :earmark-kind :general
   :statutory-basis "所得税法" :fy2024-amount-jpy 14500000000000}
  {:id :income-self-assessed :ja "申告所得税" :en "Self-assessed income tax"
   :collected-by :nta :account :general :earmark-kind :general
   :statutory-basis "所得税法" :fy2024-amount-jpy 3300000000000}
  {:id :corporate :ja "法人税" :en "Corporate tax"
   :collected-by :nta :account :general :earmark-kind :general
   :statutory-basis "法人税法" :fy2024-amount-jpy 17000000000000}
  {:id :inheritance-gift :ja "相続税・贈与税" :en "Inheritance & gift tax"
   :collected-by :nta :account :general :earmark-kind :general
   :statutory-basis "相続税法" :fy2024-amount-jpy 3200000000000}
  {:id :liquor :ja "酒税" :en "Liquor tax"
   :collected-by :nta :account :general :earmark-kind :general
   :statutory-basis "酒税法" :fy2024-amount-jpy 1180000000000}
  {:id :tobacco-national :ja "たばこ税 (国)" :en "Tobacco tax (national)"
   :collected-by :nta :account :general :earmark-kind :general
   :statutory-basis "たばこ税法" :fy2024-amount-jpy 920000000000}
  {:id :gasoline :ja "揮発油税" :en "Gasoline tax"
   :collected-by :nta :account :general :earmark-kind :general
   :statutory-basis "揮発油税法"
   :note "かつて道路特定財源 (道路整備費の財源等特例法) → 2009 一般財源化。現在は :general。"
   :fy2024-amount-jpy 2200000000000}
  {:id :vehicle-weight :ja "自動車重量税 (国)" :en "Motor vehicle tonnage tax (national)"
   :collected-by :nta :account :general :earmark-kind :general
   :statutory-basis "自動車重量税法"
   :note "かつて道路特定財源 → 2009 一般財源化。現在 国分は :general (一部 自動車安全特会)。"
   :fy2024-amount-jpy 400000000000}
  {:id :stamp :ja "印紙収入" :en "Stamp revenue"
   :collected-by :nta :account :general :earmark-kind :general
   :statutory-basis "印紙税法" :fy2024-amount-jpy 1000000000000}
  {:id :customs :ja "関税" :en "Customs duty"
   :collected-by :customs :account :general :earmark-kind :general
   :statutory-basis "関税法・関税定率法" :fy2024-amount-jpy 1000000000000}
  {:id :tonnage :ja "とん税" :en "Tonnage due"
   :collected-by :customs :account :general :earmark-kind :general
   :statutory-basis "とん税法" :fy2024-amount-jpy 10000000000}

  ;; ── 目的税的 (法律で充当先を規定するが 一般会計内・fungible, per-yen 追跡 不可) ──────
  {:id :consumption :ja "消費税 (国分)" :en "Consumption tax (national portion)"
   :collected-by :nta :account :general :earmark-kind :statutory-purpose
   :statutory-purpose :social-security
   :statutory-basis "消費税法1条2項 (社会保障4経費=年金・医療・介護・少子化対策に充当)"
   :note "全額を社会保障4経費に充てると法定。だが一般会計内のため資金は代替可能 → 法的充当方向は事実、1円追跡は不可。"
   :fy2024-amount-jpy 23800000000000}
  {:id :intl-tourist :ja "国際観光旅客税 (出国税)" :en "International tourist tax"
   :collected-by :nta :account :general :earmark-kind :statutory-purpose
   :statutory-purpose :tourism
   :statutory-basis "国際観光旅客税法 (観光の振興に充当)"
   :fy2024-amount-jpy 200000000000}

  ;; ── 特別会計・特定財源 (繰入で per-yen 追跡 可) ────────────────────────────────
  {:id :reconstruction-surtax :ja "復興特別所得税" :en "Reconstruction surtax"
   :collected-by :nta :account :general :earmark-kind :special-account
   :special-account :special/reconstruction :administered-by :fukko
   :statutory-basis "復興財源確保法 (東日本大震災復興特別会計へ繰入)"
   :fy2024-amount-jpy 410000000000}
  {:id :power-development :ja "電源開発促進税" :en "Power-source development promotion tax"
   :collected-by :nta :account :general :earmark-kind :special-account
   :special-account :special/energy :administered-by :anre
   :statutory-basis "電源開発促進税法 (エネルギー対策特別会計へ繰入)"
   :fy2024-amount-jpy 320000000000}
  {:id :petroleum-coal :ja "石油石炭税" :en "Petroleum & coal tax"
   :collected-by :nta :account :general :earmark-kind :special-account
   :special-account :special/energy :administered-by :anre
   :statutory-basis "石油石炭税法 (エネルギー対策特別会計へ繰入)"
   :fy2024-amount-jpy 600000000000}
  {:id :tobacco-special :ja "たばこ特別税" :en "Special tobacco tax"
   :collected-by :nta :account :general :earmark-kind :special-account
   :special-account :special/debt-consolidation :administered-by :mof-debt
   :statutory-basis "一般会計承継債務等処理特別措置法 (国債整理基金特別会計へ繰入)"
   :fy2024-amount-jpy 100000000000}]}
