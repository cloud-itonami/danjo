;; gov-revenue-seed.jp.edn — danjo 弾正 revenue-side seed (com.etzhayyim.gov.dataset.revenueRecord shape).
;;
;; The question this seed answers HONESTLY: "源泉所得税 及び 復興特別所得税 が、どこに、どのように
;; 使われているか 1円単位で追えるか?"  The Japanese fiscal structure gives TWO different answers,
;; and this seed encodes the difference structurally (NOT as prose):
;;
;;   (A) 源泉所得税 (withholding income tax) → 所得税 → **一般会計 (general account)** 歳入.
;;       一般会計 は ノン・アフェクタシオン原則 (non-earmarking) で運用される =
;;       :gov.account/earmark? false. A specific yen of this tax is NOT legally/accounting-ally
;;       linked to a specific 歳出. Per-yen provenance is therefore **unrepresentable** here —
;;       revenue_ledger.clj RAISES if anyone tries to link a non-earmarked revenue line to a
;;       specific outlay (the honesty analogue of danjo's G4 no-verdict gate).
;;
;;   (B) 復興特別所得税 (2.1% reconstruction surtax, 2013–2037, 特別措置法) → 一般会計を経由して
;;       **東日本大震災復興特別会計 (special account for reconstruction)** へ繰入 =
;;       :gov.account/earmark? true + an explicit :gov.transfer. A special account is a CLOSED
;;       boundary, so within it the 繰入額 → 歳出 流れ IS traceable to the yen.
;;
;; Every figure is :representative — grounded on the REAL structure (財務省 一般会計 / 復興特別会計
;; 予算) and anchored to MOF/復興庁 primary sources, but pending G7 live-verification of the
;; IPFS-pinned jp_yosan / jp_fukko corpus (danjo G3 passive-only / G5 sourcing-honesty).
;; Aggregate / program-level endpoints only — no named private recipient (danjo G10 aggregate-first).
;; NOT an authoritative budget statement.

{:source-sensor       "jp_yosan"
 :jurisdiction        "jpn"
 :currency-iso4217     "JPY"
 :verification-status "representative"
 :primary-sources     ["https://www.mof.go.jp/policy/budget/budger_workflow/account/special/"
                        "https://www.reconstruction.go.jp/topics/main-cat8/"
                        "https://www.bb.mof.go.jp/"]

 ;; ── Account boundaries (the structural core) ─────────────────────────────────
 :accounts
 [{:id :general                  :kind :general
   :ja "一般会計"                 :earmark? false
   :note "non-earmarked: fungible revenue, per-yen expenditure linkage unrepresentable (ノン・アフェクタシオン原則)"}
  {:id :special/reconstruction   :kind :special
   :ja "東日本大震災復興特別会計" :earmark? true
   :note "closed earmarked boundary: 繰入→歳出 traceable to the yen within the account"}]

 ;; ── Revenue lines ────────────────────────────────────────────────────────────
 :revenue-lines
 [{:record-id "rev-jp-2024-withholding-income"
   :tax-kind  :withholding-income
   :account   :general
   :ja        "源泉所得税 (源泉徴収による所得税)"
   :fiscal-year 2024
   :amount-jpy 14500000000000          ; ~14.5兆 (representative; 所得税のうち源泉分)
   :source-record-cids ["gov.dataset.revenueRecord:jp_yosan:2024:withholding-income#a1"
                        "gov.dataset.revenueRecord:jp_yosan:2024:income-tax-total#a2"]
   :tier "A"}
  {:record-id "rev-jp-2024-reconstruction-surtax"
   :tax-kind  :reconstruction-surtax
   :account   :general                     ; 賦課・徴収は一般会計、その後 特会へ繰入
   :ja        "復興特別所得税 (2.1%付加税)"
   :fiscal-year 2024
   :amount-jpy 410000000000             ; ~0.41兆 (representative)
   :source-record-cids ["gov.dataset.revenueRecord:jp_yosan:2024:reconstruction-surtax#b1"
                        "gov.dataset.revenueRecord:jp_fukko:2024:transfer-in#b2"]
   :tier "A"}]

 ;; ── Transfers (繰入) — only legal out of an earmarked tax into its special account ──
 :transfers
 [{:record-id "xfer-jp-2024-recon-surtax-to-special"
   :from :general :to :special/reconstruction
   :tax-kind :reconstruction-surtax
   :fiscal-year 2024
   :amount-jpy 410000000000
   :source-record-cids ["gov.dataset.transferRecord:jp_fukko:2024:surtax-in#c1"
                        "gov.dataset.budgetRecord:jp_fukko:2024:special-account#c2"]
   :tier "A"}]

 ;; ── Outlays ───────────────────────────────────────────────────────────────────
 ;; 復興特会 outlays (within the earmarked boundary — these CAN be reconciled against 繰入).
 :outlays
 [{:record-id "out-jp-2024-recon-fukushima"
   :account :special/reconstruction
   :program-code "JP-FUKKO-FUKUSHIMA"
   :program-name "福島再生・原子力災害復興"
   :cofog "06.6"
   :recipient-class "福島県・市町村・関連機関 (aggregate)"
   :fiscal-year 2024
   :amount-jpy 230000000000
   :source-record-cids ["gov.dataset.budgetRecord:jp_fukko:2024:fukushima#d1"
                        "gov.dataset.budgetRecord:jp_fukko:2024:special-account#c2"]
   :tier "A"}
  {:record-id "out-jp-2024-recon-infra"
   :account :special/reconstruction
   :program-code "JP-FUKKO-INFRA"
   :program-name "インフラ復興・住宅再建・なりわい再生"
   :cofog "06.1"
   :recipient-class "被災自治体・事業者 (aggregate)"
   :fiscal-year 2024
   :amount-jpy 150000000000
   :source-record-cids ["gov.dataset.budgetRecord:jp_fukko:2024:infra#d2"
                        "gov.dataset.budgetRecord:jp_fukko:2024:special-account#c2"]
   :tier "A"}
  {:record-id "out-jp-2024-recon-admin"
   :account :special/reconstruction
   :program-code "JP-FUKKO-ADMIN"
   :program-name "復興庁 行政経費・予備費"
   :cofog "01.1"
   :recipient-class "復興庁 (aggregate)"
   :fiscal-year 2024
   :amount-jpy 30000000000
   :source-record-cids ["gov.dataset.budgetRecord:jp_fukko:2024:admin#d3"
                        "gov.dataset.budgetRecord:jp_fukko:2024:special-account#c2"]
   :tier "A"}]}
