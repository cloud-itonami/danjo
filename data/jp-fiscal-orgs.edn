;; jp-fiscal-orgs.edn — 実在の日本財政組織レジストリ (徴収・所管), keyless mirror-actor 化.
;;
;; entity-as-actor (ADR-2606042330): 1 公的組織 = 1 keyless mirror-actor。各組織は
;; `did:web:etzhayyim.com:actor:jp-<handle>` を持つ観測ミラーであり、etzhayyim は鍵を持たず
;; (verificationMethod 空 = no-server-key)、その組織を代理・代表しない。org_actor.clj が各組織の
;; 担当スライス(徴収する税 / 所管する会計・歳出)を kotoba EAVT datom (:gov.org/*) として射影する。
;;
;; :role ∈ {:collector 徴収機関, :account-administrator 会計所管, :both}.
;; :collects は jp-national-taxes.edn の税 id を逆引きで自動補完できるが、ここでは明示もする。
;; 全て観測ミラー。NOT 権威ある statement、NOT その組織との提携。

{:source-sensor "jp_soshiki" :jurisdiction "jpn"
 :verification-status "representative"
 :orgs
 [{:id :nta :handle "jp-nta"
   :ja "国税庁" :en "National Tax Agency"
   :did "did:web:etzhayyim.com:actor:jp-nta"
   :role :collector
   :parent "財務省 (Ministry of Finance)"
   :note "内国税の賦課徴収。源泉/申告所得税・法人税・消費税・相続税・酒税・たばこ税・揮発油税・印紙ほか。"
   :source-url "https://www.nta.go.jp/"}

  {:id :customs :handle "jp-customs"
   :ja "税関 (財務省関税局)" :en "Japan Customs / Customs and Tariff Bureau"
   :did "did:web:etzhayyim.com:actor:jp-customs"
   :role :collector
   :parent "財務省 (Ministry of Finance)"
   :note "関税・とん税・輸入時の消費税等の賦課徴収。"
   :source-url "https://www.customs.go.jp/"}

  {:id :fukko :handle "jp-fukko"
   :ja "復興庁" :en "Reconstruction Agency"
   :did "did:web:etzhayyim.com:actor:jp-fukko"
   :role :account-administrator
   :administers [:special/reconstruction]
   :note "東日本大震災復興特別会計を所管。復興特別所得税の繰入を原資に復興事業を執行。"
   :source-url "https://www.reconstruction.go.jp/"}

  {:id :anre :handle "jp-anre"
   :ja "資源エネルギー庁 (経済産業省)" :en "Agency for Natural Resources and Energy"
   :did "did:web:etzhayyim.com:actor:jp-anre"
   :role :account-administrator
   :administers [:special/energy]
   :parent "経済産業省 (METI)"
   :note "エネルギー対策特別会計を所管。電源開発促進税・石油石炭税の繰入を原資にエネルギー対策を執行。"
   :source-url "https://www.enecho.meti.go.jp/"}

  {:id :mof-debt :handle "jp-mof-debt"
   :ja "財務省理財局 (国債整理基金特別会計)" :en "MOF Financial Bureau (Debt Consolidation Fund)"
   :did "did:web:etzhayyim.com:actor:jp-mof-debt"
   :role :account-administrator
   :administers [:special/debt-consolidation]
   :parent "財務省 (Ministry of Finance)"
   :note "国債整理基金特別会計を所管。たばこ特別税等の繰入で承継債務の処理に充当。"
   :source-url "https://www.mof.go.jp/jgbs/"}

  {:id :mof-budget :handle "jp-mof-budget"
   :ja "財務省主計局 (一般会計)" :en "MOF Budget Bureau (General Account)"
   :did "did:web:etzhayyim.com:actor:jp-mof-budget"
   :role :account-administrator
   :administers [:general]
   :parent "財務省 (Ministry of Finance)"
   :note "一般会計の予算編成・所管。fungible のため特定税目→特定歳出の1円追跡は構造上不可。"
   :source-url "https://www.mof.go.jp/policy/budget/"}

  ;; ── 地方団体 (aggregate keyless mirror-actors; 国 + 地方 で税の全体像) ──────────────
  ;; coverage honesty: 47都道府県 / 1741市町村 を 2 つの aggregate actor で代表する
  ;; (ooyake G5 — 集約であることを明示。将来 個別団体への分解は拡張)。
  {:id :prefecture-agg :handle "jp-prefecture-agg"
   :ja "都道府県 (集約)" :en "Prefectures (aggregate)"
   :did "did:web:etzhayyim.com:actor:jp-prefecture-agg"
   :role :collector :level :local :aggregate true :represents-count 47
   :note "47都道府県の地方税徴収を集約代表する観測ミラー。法人住民税・事業税・地方消費税・自動車税・不動産取得税ほか。"
   :source-url "https://www.soumu.go.jp/main_sosiki/jichi_zeisei/"}

  {:id :municipality-agg :handle "jp-municipality-agg"
   :ja "市町村 (集約)" :en "Municipalities (aggregate)"
   :did "did:web:etzhayyim.com:actor:jp-municipality-agg"
   :role :collector :level :local :aggregate true :represents-count 1741
   :note "1741市町村の地方税徴収を集約代表する観測ミラー。個人住民税・固定資産税・都市計画税・軽自動車税ほか。"
   :source-url "https://www.soumu.go.jp/main_sosiki/jichi_zeisei/"}]}
